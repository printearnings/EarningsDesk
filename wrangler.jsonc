{
  // One Worker serves BOTH the static site and the live-refresh API.
  //
  // Cloudflare's own migration guide is explicit that `wrangler pages deploy`
  // is superseded by Workers Static Assets, so this deploys with
  // `wrangler deploy` — never `wrangler pages deploy`.
  //
  // Unifying them is not just tidier than "Pages + a separate API Worker":
  // the API is then SAME-ORIGIN with the page, so there are no CORS headers to
  // configure, no preflight, and no cross-origin path by which another site
  // could fire /api/refresh and burn the Massive quota.
  "name": "earningsdesk",
  "compatibility_date": "2026-08-08",
  // mimetext (building the support-form email) needs Node's Buffer/crypto
  // shims — the one thing in this Worker that isn't pure Web APIs.
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/src/index.ts",

  // Adding `routes` makes Wrangler disable the free workers.dev URL by
  // default (a silent behavior change, not something this file used to
  // need an opinion on) — keep it explicitly on. earningsdesk.pkhai.workers.dev
  // stays live as a bare-Worker fallback alongside the real domain below.
  "workers_dev": true,

  // Workers Custom Domains: `wrangler deploy` provisions the DNS record and
  // SSL cert itself as long as the zone is already on this Cloudflare
  // account (it is — printearnings.com shows "DNS Setup: Full"). No manual
  // DNS record needed for either host.
  "routes": [
    { "pattern": "printearnings.com", "custom_domain": true },
    { "pattern": "www.printearnings.com", "custom_domain": true },
  ],

  "assets": {
    // `next build` with output: "export" writes here.
    "directory": "./web/out",
    "binding": "ASSETS",

    // NOT "single-page-application" — this is a statically generated site
    // with a real page per route, so an unknown path is a genuine 404 and
    // should say so rather than silently serving the calendar.
    "not_found_handling": "404-page",

    // Static assets win by default; these paths go to the Worker script
    // instead. Scoped to /api/* so page loads never pay for Worker startup.
    "run_worker_first": ["/api/*"],
  },

  "kv_namespaces": [
    {
      // Per-IP AND global (site-wide) rate limiting, shared by every
      // Massive-touching endpoint (refresh, search, chart, indicators,
      // financials).
      "binding": "RATE_LIMIT",
      "id": "9135f20d01354929b7b2eb0681e7bd66",
    },
  ],

  // Support-form submissions go out through Email Routing's existing
  // verified destination rather than a third-party mail API — no new
  // account/domain onboarding needed since Email Routing is already set up
  // for this domain. `destination_address` is the owner's real inbox; the
  // support@printearnings.com address is only ever the From/Reply-To the
  // recipient sees, never something the browser/page source exposes.
  "send_email": [
    {
      "name": "SUPPORT_EMAIL",
      "destination_address": "patrickkhai98@gmail.com",
    },
  ],

  "vars": {
    "LIVE_REFRESH_PER_HOUR": "10",
    "SEARCH_PER_HOUR": "60",
    "SUPPORT_PER_HOUR": "5",
    "CHAIN_PER_HOUR": "10",

    // Global circuit breakers — protect total Massive spend against many
    // concurrent visitors, not just one abusive IP. See the SCALE note in
    // worker/src/index.ts.
    "GLOBAL_REFRESH_PER_HOUR": "300",
    "GLOBAL_SEARCH_PER_HOUR": "5000",
    "GLOBAL_CHART_PER_HOUR": "3000",
    "GLOBAL_INDICATORS_PER_HOUR": "1500",
    "GLOBAL_FINANCIALS_PER_HOUR": "1000",
    "GLOBAL_SUPPORT_PER_HOUR": "50",
    "GLOBAL_CHAIN_PER_HOUR": "300",
    "GLOBAL_INSIDERS_PER_HOUR": "1000",
  },

  "observability": {
    "enabled": true,
  },

  // Dev environment: a separate Worker service (its own name, its own
  // workers.dev URL, its own KV) so testing here can never touch production
  // data or traffic. `routes` is explicitly emptied — `routes`/`route` is an
  // inheritable key, and without this it would try to attach the SAME
  // printearnings.com custom domain to a second Worker service, which fails
  // (a custom domain can only point at one Worker). `vars`/`kv_namespaces`
  // are non-inheritable in Wrangler regardless, so they're repeated here on
  // purpose, not duplicated by accident.
  //
  //   wrangler deploy --env dev            deploys here
  //   wrangler secret put MASSIVE_API_KEY --env dev   (same key, separate secret store)
  "env": {
    "dev": {
      "name": "earningsdesk-dev",
      "routes": [],
      "kv_namespaces": [
        {
          "binding": "RATE_LIMIT",
          "id": "7faa19f385c14b58b8369f78fcd3ba6d",
        },
      ],
      "send_email": [
        {
          "name": "SUPPORT_EMAIL",
          "destination_address": "patrickkhai98@gmail.com",
        },
      ],
      "vars": {
        "LIVE_REFRESH_PER_HOUR": "10",
        "SEARCH_PER_HOUR": "60",
        "SUPPORT_PER_HOUR": "5",
        "CHAIN_PER_HOUR": "10",
        "GLOBAL_REFRESH_PER_HOUR": "300",
        "GLOBAL_SEARCH_PER_HOUR": "5000",
        "GLOBAL_CHART_PER_HOUR": "3000",
        "GLOBAL_INDICATORS_PER_HOUR": "1500",
        "GLOBAL_FINANCIALS_PER_HOUR": "1000",
        "GLOBAL_SUPPORT_PER_HOUR": "50",
        "GLOBAL_CHAIN_PER_HOUR": "300",
        "GLOBAL_INSIDERS_PER_HOUR": "1000",
      },
    },
  },

  // MASSIVE_API_KEY is a secret, not a var:
  //   wrangler secret put MASSIVE_API_KEY            (production)
  //   wrangler secret put MASSIVE_API_KEY --env dev   (dev)
}
