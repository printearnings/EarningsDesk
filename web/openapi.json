{
  "openapi": "3.1.0",
  "info": {
    "title": "EarningsDesk API",
    "description": "Read-only earnings + options data for the EarningsDesk dashboard.",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Healthz",
        "description": "Liveness + configuration report.\n\nDeliberately reports *which* feature flags are off rather than just\nok/not-ok: the most likely failure here is a silently unloaded .env,\nwhich looks identical to a healthy app until you request real data.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/calendar": {
      "get": {
        "tags": [
          "calendar"
        ],
        "summary": "Get Calendar",
        "operationId": "get_calendar_api_calendar_get",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 90,
              "minimum": 1,
              "default": 14,
              "title": "Days"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/ticker/{ticker}": {
      "get": {
        "tags": [
          "ticker"
        ],
        "summary": "Get Ticker",
        "operationId": "get_ticker_api_ticker__ticker__get",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ticker"
            }
          },
          {
            "name": "with_prices",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "fetch the price chart series",
              "default": true,
              "title": "With Prices"
            },
            "description": "fetch the price chart series"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TickerPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/calendar/full": {
      "get": {
        "tags": [
          "calendar"
        ],
        "summary": "Get Calendar Full",
        "operationId": "get_calendar_full_api_calendar_full_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/past-earnings": {
      "get": {
        "tags": [
          "past-earnings"
        ],
        "summary": "Get Past Earnings",
        "operationId": "get_past_earnings_api_past_earnings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PastEarningsPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/signals": {
      "get": {
        "tags": [
          "signals"
        ],
        "summary": "Get Signals",
        "operationId": "get_signals_api_signals_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalsPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/track-record": {
      "get": {
        "tags": [
          "track-record"
        ],
        "summary": "Get Track Record",
        "operationId": "get_track_record_api_track_record_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackRecordPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/index": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Get Index",
        "operationId": "get_index_api_index_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteIndex"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
