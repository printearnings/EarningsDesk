# EarningsDesk — copy to .env and fill in. NEVER commit the filled copy.
#
# Preferred setup: don't duplicate secrets. Point at the engine repo's existing
# .env and leave everything below it blank — app/bootstrap.py loads that file
# and the engine reads its own settings from the resulting environment.

EARNINGS_ENV_FILE

# ---------------------------------------------------------------------------
# Only needed if you are NOT using EARNINGS_ENV_FILE above.
# Names must match earnings/config.py exactly.
# ---------------------------------------------------------------------------

# DATABASE_URL=postgresql+psycopg://user:pass@host/db
# MASSIVE_API_KEY=
# RAPIDAPI_KEY=
# TOOLS_API_KEY=          # Anthropic key — named this way to avoid colliding
#                         # with the inherited ANTHROPIC_API_KEY

# ---------------------------------------------------------------------------
# API-only settings (see api/app/config.py). All optional.
# ---------------------------------------------------------------------------

# Comma-separated. Add your deployed frontend origin here.
CORS_ORIGINS=http://localhost:3000

# Each live refresh spends one metered Massive call. Per-IP hourly cap.
LIVE_REFRESH_PER_HOUR=10

# Snapshots older than this are labelled stale in the UI. The nightly cron
# keeps them under 24h; 36h tolerates one missed run.
SNAPSHOT_STALE_AFTER_HOURS=36

# API_DEBUG=1

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Cloudflare Worker (wrangler.jsonc) — needed for `npm run dev`/`deploy*`.
# ---------------------------------------------------------------------------

# Real inbox the support form's send_email binding delivers to. Filled into
# wrangler.generated.jsonc by scripts/gen-wrangler-config.mjs; never goes in
# the tracked wrangler.jsonc.
# SUPPORT_DESTINATION_EMAIL=you@example.com
